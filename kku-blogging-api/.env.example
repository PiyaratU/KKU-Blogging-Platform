# คัดลอกไฟล์นี้เป็น kku-blogging-api/.env แล้วใส่ค่าจริง (ห้าม commit .env)

PORT=3005

# MongoDB Atlas → Connect → Drivers  (ขึ้นต้น mongodb+srv://)
ATLAS_URI=

# ข้อความลับสำหรับเซ็น token เข้าสู่ระบบ — สุ่มยาว ๆ เช่น  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# อายุ session หลังเข้าสู่ระบบ (เช่น 30m, 12h, 1d) — ไม่ใส่ = 1d
SESSION_EXPIRES_IN=1d

# URL หน้าเว็บผู้ใช้ (ใช้ทำลิงก์ในอีเมล ลืมรหัสผ่าน / แจ้งเตือน และอนุญาต CORS) — บน Vercel ใส่โดเมนจริง เช่น https://kku-blogging.vercel.app
FRONTEND_ENDPOINT=http://localhost:3000
# URL เว็บผู้ดูแลระบบ (โฟลเดอร์ kku-blogging-admin — deploy แยก) — ใช้อนุญาต CORS และทำลิงก์ลืมรหัสผ่านของแอดมิน
# หลายโดเมนคั่นด้วย , เช่น https://admin.kkublogging.com,https://kku-admin.vercel.app
ADMIN_FRONTEND_ENDPOINT=http://localhost:3006
# อีเมลผู้ดูแลระบบที่เพิ่มผู้ดูแลระบบคนอื่นได้ (คั่นด้วย ,) — ไม่ใส่ = ผู้ดูแลระบบทุกคนเพิ่มได้
# (ผู้ดูแลระบบคนแรกสมัครด้วยรหัส ADMIN_SETUP_KEY ด้านล่าง)
SUPER_ADMIN_EMAILS=
# รหัสสำหรับสร้างผู้ดูแลระบบคนแรก (ใช้ได้เฉพาะตอนระบบยังไม่มีผู้ดูแลระบบ) — สุ่มยาวอย่างน้อย 12 ตัว
# เช่น  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SETUP_KEY=

# บัญชีอีเมลที่ใช้ส่งเมล — Gmail ต้องใช้ App Password ไม่ใช่รหัสผ่านปกติ
MAIL_USER=
MAIL_PASS=

# Sign in with Google — OAuth Client ID เดียวกับ REACT_APP_GOOGLE_CLIENT_ID ของเว็บ (หลายตัวคั่นด้วย ,)
# Google Cloud Console → APIs & Services → Credentials · ไม่ใช่ข้อมูลลับ และไม่ต้องใช้ Client secret
GOOGLE_CLIENT_ID=
