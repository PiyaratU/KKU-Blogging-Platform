# คัดลอกไฟล์นี้เป็น server/.env แล้วใส่ค่าจริง (ห้าม commit .env)

PORT=3001

# MongoDB Atlas → Connect → Drivers  (ขึ้นต้น mongodb+srv://)
ATLAS_URI=

# ข้อความลับสำหรับเซ็น token เข้าสู่ระบบ — สุ่มยาว ๆ เช่น  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL หน้าเว็บ (ใช้ทำลิงก์ในอีเมล ลืมรหัสผ่าน / แจ้งเตือน)
FRONTEND_ENDPOINT=http://localhost:3000

# บัญชีอีเมลที่ใช้ส่งเมล — Gmail ต้องใช้ App Password ไม่ใช่รหัสผ่านปกติ
MAIL_USER=
MAIL_PASS=

# key ของ Firebase Admin (Firebase Console → Project settings → Service accounts → Generate new private key)
# เลือกอย่างใดอย่างหนึ่ง — ไม่ใส่เลย server ยังรันได้ แต่เข้าสู่ระบบด้วย Google ไม่ได้
#   FIREBASE_SERVICE_ACCOUNT       = เนื้อหาไฟล์ JSON ทั้งก้อนในบรรทัดเดียว
#   FIREBASE_SERVICE_ACCOUNT_PATH  = path ของไฟล์ JSON (ค่าเริ่มต้น: kku-blogging-firebase-adminsdk-blvad-4d6e110e4e.json)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
