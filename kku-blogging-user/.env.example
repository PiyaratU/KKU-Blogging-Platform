# คัดลอกไฟล์นี้เป็น kku-blogging-user/.env แล้วใส่ค่าจริง (ห้าม commit .env)
# ค่าทุกตัวในไฟล์นี้จะถูกฝังลงในหน้าเว็บ — ห้ามใส่ข้อมูลลับ

# URL ของ API server (แชทเรียลไทม์ / socket อยู่ใน API แล้ว — SOCKET_ENDPOINT ไม่ใส่ก็ได้ จะใช้ URL ของ API)
REACT_APP_API_ENDPOINT=http://localhost:3005
REACT_APP_SOCKET_ENDPOINT=

# Cloudinary — ที่เก็บรูปโปรไฟล์ / รูปในบล็อก (ฟรี ไม่ต้องผูกบัตร)
#   Cloud name: หน้า Dashboard · Upload preset: Settings → Upload → Add upload preset (Signing mode = Unsigned)
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=

# Firebase Web App — ใช้แค่ Google login (Firebase Console → Project settings → General → Your apps)
# ไม่ใส่ = ใช้โปรเจกต์ kku-blogging เดิม
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
